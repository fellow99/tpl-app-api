# ============================================================
# tpl-app-api 环境变量样例（复制为 .env 后填入真实值）
# .env 不入库；本样例仅提供简单占位值
# 加载机制：me.paulschwarz:spring-dotenv
# ============================================================

# JWT 签名密钥（生产必须强随机）
SA_TOKEN_JWT_SECRET=changeMe

# AES+RSA 请求解密私钥（RSA-2048 PKCS#8 Base64，与前端公钥对应）
RSA_PRIVATE_KEY=changeMe

# 数据库连接
DB_URL=jdbc:postgresql://localhost:35432/tpl_manage
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis 连接
REDIS_HOST=localhost
REDIS_PORT=36379
REDIS_PASSWORD=postgres

# 短信平台（Spug Push）
SMS_BASE_URL=https://push.spug.cc
SMS_TEMPLATE_CODE=changeMe

# 微信登录（填入开放平台/公众平台 AppID/Secret 后各端登录才可用）
WECHAT_LOGIN_ENABLED=true
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=
WECHAT_WEB_REDIRECT_URI=
WECHAT_APP_APPID=
WECHAT_APP_SECRET=
WECHAT_XCX_APPID=wxChangeMe
WECHAT_XCX_SECRET=
